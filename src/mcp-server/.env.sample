# Copy to .env for local runs (run `az login` first - DefaultAzureCredential uses your identity)
DOCINTEL_ENDPOINT=https://<docintel>.cognitiveservices.azure.com/
DOCINTEL_MODEL=prebuilt-invoice
STORAGE_ACCOUNT_URL=https://<storage>.blob.core.windows.net
ALLOWED_DOCUMENT_HOSTS=*.blob.core.windows.net
MCP_API_KEY=local-dev-key
MISSING_VALUE=NA
